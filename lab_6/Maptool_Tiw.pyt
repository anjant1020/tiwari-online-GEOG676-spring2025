# -*- coding: utf-8 -*-import arcpyimport osimport timeclass Toolbox(object):    def __init__(self):        self.label = "MapTool_Tiw"        self.alias = "maptool_tiw"        # IMPORTANT: the class name here must match the tool class below        self.tools = [GenerateGraduatedColorMap]class GenerateGraduatedColorMap(object):    def __init__(self):        self.label = "Generate Graduated Color Map"        self.description = "Apply graduated colors symbology to a layer and save a copy of the ArcGIS Pro project."        self.canRunInBackground = False        self.category = "Map Tools"    def getParameterInfo(self):        # 0) Input ArcGIS Pro Project (.aprx)        p0 = arcpy.Parameter(            displayName="Input ArcGIS Pro Project (.aprx)",            name="in_aprx",            datatype="DEFile",            parameterType="Required",            direction="Input"        )        p0.filter.list = ["aprx"]        # 1) Layer Name (exact name from Contents)        p1 = arcpy.Parameter(            displayName="Layer Name to Classify (e.g., GarageParking)",            name="layer_name",            datatype="GPString",            parameterType="Required",            direction="Input"        )        # 2) Classification Field (numeric)        p2 = arcpy.Parameter(            displayName="Classification Field (e.g., Shape_Area)",            name="class_field",            datatype="GPString",            parameterType="Required",            direction="Input"        )        p2.value = "Shape_Area"        # 3) Number of Classes        p3 = arcpy.Parameter(            displayName="Number of Classes",            name="num_classes",            datatype="GPLong",            parameterType="Required",            direction="Input"        )        p3.value = 5        # 4) Color Ramp Name (optional)        p4 = arcpy.Parameter(            displayName="Color Ramp Name (optional, e.g., Oranges (5 Classes))",            name="color_ramp",            datatype="GPString",            parameterType="Optional",            direction="Input"        )        p4.value = "Oranges (5 Classes)"        # 5) Output Folder        p5 = arcpy.Parameter(            displayName="Output Location (folder)",            name="out_folder",            datatype="DEFolder",            parameterType="Required",            direction="Input"        )        # 6) Output Project Name        p6 = arcpy.Parameter(            displayName="Output Project Name (no .aprx)",            name="out_name",            datatype="GPString",            parameterType="Required",            direction="Input"        )        return [p0, p1, p2, p3, p4, p5, p6]    def isLicensed(self):        return True    def updateParameters(self, parameters):        return    def updateMessages(self, parameters):        return    def execute(self, parameters, messages):        in_aprx = parameters[0].valueAsText        layer_name = parameters[1].valueAsText        class_field = parameters[2].valueAsText        num_classes = int(parameters[3].value)        ramp_name = parameters[4].valueAsText if parameters[4].valueAsText else ""        out_folder = parameters[5].valueAsText        out_name = parameters[6].valueAsText        # --- Progressor (rubric) ---        read_time = 1        start = 0        end = 100        step = 25        arcpy.SetProgressor("step", "Starting...", start, end, step)        def bump(label, pos):            arcpy.SetProgressorLabel(label)            arcpy.SetProgressorPosition(pos)            arcpy.AddMessage(label)            time.sleep(read_time)        bump("Opening ArcGIS Pro project...", 0)        aprx = arcpy.mp.ArcGISProject(in_aprx)        # Safer than relying on a map named "Map"        maps = aprx.listMaps()        if not maps:            raise arcpy.ExecuteError("No maps found in the project.")        m = maps[0]        bump("Searching for target layer...", 25)        target = None        for lyr in m.listLayers():            if lyr.isFeatureLayer and lyr.name == layer_name:                target = lyr                break        if target is None:            raise arcpy.ExecuteError(                f"Layer '{layer_name}' not found. Use the exact name from the Contents pane."            )        bump("Applying graduated colors symbology...", 50)        # Check field exists        field_names = [f.name for f in arcpy.ListFields(target)]        if class_field not in field_names:            raise arcpy.ExecuteError(                f"Field '{class_field}' not found in layer '{layer_name}'. Choose a valid numeric field."            )        sym = target.symbology        sym.updateRenderer("GraduatedColorsRenderer")        sym.renderer.classificationField = class_field        sym.renderer.breakCount = num_classes        # Try to set a color ramp if available        if ramp_name:            ramps = aprx.listColorRamps(ramp_name)            if ramps:                sym.renderer.colorRamp = ramps[0]            else:                # fallback: pick first ramp containing "Oranges"                fallback = aprx.listColorRamps("Oranges")                if fallback:                    sym.renderer.colorRamp = fallback[0]        target.symbology = sym        bump("Saving project copy...", 75)        out_path = os.path.join(out_folder, out_name + ".aprx")        aprx.saveACopy(out_path)        bump("Done!", 100)        arcpy.AddMessage(f"Saved output project: {out_path}")